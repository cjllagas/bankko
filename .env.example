# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bankko

# Long random string (32+ characters), e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# true = TypeORM creates/updates the tables automatically (development only)
DB_SYNC=true
# Set true only when running behind a reverse proxy
TRUST_PROXY=false

# Optional: 'mysql' or 'mariadb'. Leave empty and the app detects it (XAMPP uses MariaDB).
DB_TYPE=

# Login verification code (two-step login). Set OTP_ENABLED=false only for automated Postman runs.
OTP_ENABLED=true
# Optional SMTP so the code is emailed (e.g. Gmail: host smtp.gmail.com, port 587, an App Password).
# Leave SMTP_HOST empty in development and the code is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bankko <no-reply@bankko.example>
