# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bankko

# Long random string (32+ characters), e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# true = TypeORM creates/updates the tables automatically (development only)
DB_SYNC=true
# Set true only when running behind a reverse proxy
TRUST_PROXY=false

# Optional: 'mysql' or 'mariadb'. Leave empty and the app detects it (XAMPP uses MariaDB).
DB_TYPE=
